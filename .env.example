# Copy this file to .env and fill in ONE of the AI options (or none for heuristic mode).

# Option 1 — Claude (Anthropic API key from console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Option 2 — any OpenAI-compatible endpoint (free tiers work)
# Google Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
# Groq:           LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
# Ollama (local): LLM_BASE_URL=http://localhost:11434/v1                                LLM_MODEL=llama3.1   (no key needed)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Force a provider: anthropic | openai_compat | none   (default: auto)
# LLM_PROVIDER=auto

# Tuning
# MAX_EVIDENCE=24
# FETCH_ARTICLE_BODIES=6
# HTTP_TIMEOUT=12
